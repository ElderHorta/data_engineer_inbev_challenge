# Environment Configuration
# Copy this file to .env and adjust values as needed

# ============================================
# Docker Compose Configuration
# ============================================
# Required for Airflow on Linux/macOS (run: echo $(id -u) to get your UID)
# On Windows with Docker Desktop, you can leave this as default
AIRFLOW_UID=50000

# Airflow Web UI credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ============================================
# Storage Configuration
# ============================================
STORAGE_TYPE=local
BASE_PATH=/data/

# For cloud deployment, use:
# STORAGE_TYPE=cloud
# BASE_PATH=gs://brewery-data-lake/  # GCP
# BASE_PATH=s3://brewery-data-lake/  # AWS
# BASE_PATH=abfss://container@account.dfs.core.windows.net/  # Azure

# ============================================
# Airflow Configuration
# ============================================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__CORE__PARALLELISM=32
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=1

AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# ============================================
# Pipeline Configuration
# ============================================
API_BASE_URL=https://api.openbrewerydb.org/v1
API_TIMEOUT=30
API_RETRIES=3
BATCH_SIZE=200

# ============================================
# Data Quality
# ============================================
DATA_QUALITY_THRESHOLD=0.80
ENABLE_GREAT_EXPECTATIONS=true

# ============================================
# Monitoring & Alerts
# ============================================
ENABLE_SLACK_ALERTS=false
SLACK_WEBHOOK_URL=

ENABLE_EMAIL_ALERTS=true
ALERT_EMAIL=data-engineering@company.com

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Spark Configuration
# ============================================
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ============================================
# Development
# ============================================
ENVIRONMENT=development
DEBUG=false
